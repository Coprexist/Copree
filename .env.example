# 数据库
DB_PASSWORD=change_me_please

# JWT
JWT_SECRET_KEY=change_me_to_a_random_secret_key_at_least_32_chars

# DeepSeek API（全局默认，用户可自行覆盖）
# 注意：每个用户应配置自己的 API Key，此处仅用于系统级操作
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Embedding 提供方插件化（可选，默认 disabled 纯文本检索）──
# 后端: disabled | ollama | api | local
#   disabled = 不启用向量（默认，行为与旧版一致）
#   ollama   = 本地/远程 Ollama 实例（有 Ollama 直接复用，无需额外部署）
#   api      = 任意 OpenAI 兼容 /v1/embeddings（OpenAI/硅基流动/智谱/阿里云）
#   local    = fastembed 本地模型（离线可用，需 pip install fastembed）
# EMBEDDING_BACKEND=disabled
# EMBEDDING_BASE_URL=http://127.0.0.1:11434   # ollama 原生 或 https://host/v1 (api)
# EMBEDDING_API_KEY=                           # 仅 api 后端需要
# EMBEDDING_MODEL=nomic-embed-text             # ollama；api 如 text-embedding-3-small / bge-large-zh-v1.5；local 如 BAAI/bge-small-zh-v1.5
# 向量维度（用户自选：存储速度 vs 检索质量的取舍）
# 需与模型匹配：nomic-embed-text=768 / text-embedding-3-small=1536 / bge-large-zh-v1.5=1024 / bge-small-zh=512
# 默认 1536（兼容现状）；prestart 启动时自动把 PG 列对齐到此值（无向量数据时毫秒级）
# EMBEDDING_DIMENSION=1536

# 联邦通信 — GitHub 注册表（可选，仅"一键注册公网 ID"功能需要）
# 在 https://github.com/settings/tokens 生成 Fine-grained token，需要仓库读写权限
# GITHUB_TOKEN=github_pat_xxxxxxxxxxxx
# 注册表仓库和文件路径（默认值通常无需修改）
# REGISTRY_REPO=ShuAICFR/Copree
# REGISTRY_FILE=federation-registry.json

# 数据存储目录 —— 宿主机上的那一份，compose 拿它做挂载源（${DATA_DIR:-./data} → /app/data）
# 默认为 ./data，可改为绝对路径如 /mnt/data 或 d:/docker-data
# 容器内的应用看到的是挂载点，由 compose 的 backend.environment 钉成 /app/data：
# 别在容器里用宿主路径，否则插件与世界的文件会落在容器可写层、重建即丢。
# 留空也行：默认按部署布局推——容器内 /app/data、宿主机 <repo>/data（与这里的挂载源同一处）。
# DATA_DIR=./data
# ── 版本更新检查（可选，默认开启）──
# 管理面板「通用 → 版本与更新」与桌面端提示条的数据来源：后台每小时最多访问一次上游，
# 前端只读本机接口，所以浏览器/桌面壳都不会直连 GitHub。
# 离线/内网部署把它关掉，界面会安静地显示「无法检查」，不影响任何功能。
# UPDATE_CHECK_ENABLED=true
# 任何返回 JSON 的地址都行：GitHub Releases API（默认）或自建镜像的简单形状
#   {"version":"v0.4.16","url":"https://…","notes":"…","assets":[{"name":"…","url":"…"}]}
# 默认取列表（一次就能同时看到正式版与预发布），由渠道设置挑一条
# UPDATE_CHECK_URL=https://api.github.com/repos/Coprexist/Copree-Releases/releases?per_page=20
# 更新渠道：stable 只认正式版；beta 连预发布一起认（内测机用）。写错一律退回 stable
# UPDATE_CHECK_CHANNEL=stable
# 缓存窗口（秒）：上游最多每小时被请求一次——未认证 GitHub API 只有 60 次/小时
# UPDATE_CHECK_TTL_SECONDS=3600
# UPDATE_CHECK_TIMEOUT_SECONDS=6
#
# 发行方式：source（源码部署）| docker（compose 部署，由 compose 注入）| desktop（安装包）。
# 它只决定「怎么升级」的引导文案：给 docker compose 命令、还是给安装包下载按钮。
# APP_DISTRIBUTION=source
